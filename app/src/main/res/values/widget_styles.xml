<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetPal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:contentDescription">@null</item>
    </style>
    <style name="WidgetHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/baloo2_extrabold</item>
        <item name="android:textColor">#FFFFF1DC</item>
        <item name="android:textSize">16sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <style name="WidgetBubble">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/widget_bubble</item>
        <item name="android:fontFamily">@font/baloo2_extrabold</item>
        <item name="android:textColor">#FF1D140E</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
