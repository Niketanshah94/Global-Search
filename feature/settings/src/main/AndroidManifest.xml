            </intent-filter>
        </activity>

        <activity
            android:name=".billing.PaywallActivity"
            android:exported="false"
            android:theme="@style/Theme.QuickFind">
            <intent-filter>
                <action android:name="com.quickfind.action.PAYWALL" />
