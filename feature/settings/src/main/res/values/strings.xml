    <string name="pro_title">QuickFind Pro</string>
    <string name="pro_summary">Coming soon</string>
    <string name="about_title">About</string>
    <string name="version">Version %1$s</string>
    <string name="about_privacy">QuickFind searches your phone on your phone. Nothing you type or index leaves the device. The only network request downloads public exchange rates (European Central Bank, via frankfurter.app) when you convert a currency, and you can turn that off.</string>
    <string name="licenses">Open-source licenses</string>

    <string name="disclosure_contacts_title">Search your contacts?</string>
    <string name="disclosure_contacts_text">QuickFind reads your contacts to find them by name or number. They are kept on this phone and never uploaded.</string>
    <string name="disclosure_files_title">Search your files?</string>
    <string name="disclosure_files_text">QuickFind reads file names and folders to build a search index on this phone. File contents are not read and nothing is uploaded.</string>
    <string name="disclosure_all_files_title">Turn on full file search?</string>
    <string name="disclosure_all_files_text">To find documents, downloads and other non-media files anywhere on your phone, Android needs you to allow “All files access” for QuickFind on the next screen. QuickFind only reads names and folders to build a search index that never leaves this phone.</string>

    <string name="onboarding_1_title">Find anything on your phone</string>
    <string name="onboarding_1_text">Apps, contacts, files, settings and quick sums, from one search bar. Type two or three letters and press Enter.</string>
    <string name="onboarding_2_title">Choose what to search</string>
    <string name="onboarding_2_text">Apps, settings and the calculator work right away. Contacts and files need your permission; you can change this later.</string>
    <string name="onboarding_3_title">Open search from anywhere</string>
    <string name="onboarding_3_text">Make QuickFind your default assistant app to open search with a long-press on Home or a corner swipe. You can also use the widget or the Quick Settings tile.</string>
